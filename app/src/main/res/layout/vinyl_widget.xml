<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_preview" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:id="@+id/widget_main" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clickable="true" android:focusable="true" android:contentDescription="打开唱片机" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal"
            android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingBottom="4dp">
            <FrameLayout android:id="@+id/widget_speaker" android:layout_width="52dp" android:layout_height="match_parent"
                android:visibility="gone" android:importantForAccessibility="no" />
            <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:contentDescription="上一首" android:background="@drawable/widget_control_touch" />
            <ImageButton android:id="@+id/widget_play" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:contentDescription="播放" android:background="@drawable/widget_control_touch" />
            <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:contentDescription="下一首" android:background="@drawable/widget_control_touch" />
        </LinearLayout>
    </LinearLayout>
    <ImageButton android:id="@+id/widget_configure" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|right" android:layout_margin="4dp" android:contentDescription="更换小组件样式"
        android:background="@drawable/widget_control_touch" />
</FrameLayout>
